rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Rider status documents ──────────────────────────────────────────
    // Each rider device writes only its own document.
    // Fleet managers (and the Cloud Function service account) may read all.
    match /riders/{deviceId} {

      // Any authenticated user may read rider data (fleet dashboard).
      allow read: if request.auth != null;

      // A device may only write its own document and only if the
      // incoming data passes basic shape validation.
      allow write: if request.auth != null
                   && request.auth.uid == deviceId
                   && isValidRiderDoc(request.resource.data);

      // Alert subcollection — append-only by the owning device.
      match /alerts/{alertId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == deviceId;
        allow update, delete: if false;   // immutable alert log
      }

      // Session stats — written by the owning device only.
      match /session/{doc} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null
                     && request.auth.uid == deviceId;
      }
    }

    // ── Validation helpers ──────────────────────────────────────────────
    function isValidRiderDoc(data) {
      return data.keys().hasAll(['riderName', 'eyeState', 'connected', 'updatedAt'])
          && data.eyeState  in ['OPEN', 'CLOSED', 'UNKNOWN']
          && data.connected is bool
          && data.riderName is string
          && data.riderName.size() <= 80
          // perclos must be a number in [0, 100] when present
          && (!('perclos' in data) || (data.perclos >= 0 && data.perclos <= 100))
          // updatedAt must be a server timestamp (prevents client clock spoofing)
          && data.updatedAt == request.time;
    }
  }
}
