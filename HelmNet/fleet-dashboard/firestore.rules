rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Rider status documents ──────────────────────────────────────────
    // Identity note: a rider device's document id is a random UUID
    // (Prefs.getDeviceId), which is NOT the same as the Firebase Auth uid
    // (the rider signs in with Phone Auth). So we CANNOT gate writes on
    // request.auth.uid == deviceId — that would reject every device write.
    // We gate on authentication + light schema validation instead.
    match /riders/{deviceId} {

      allow read:  if request.auth != null;
      allow write: if request.auth != null && isValidRiderUpdate(request.resource.data);

      // Alert subcollection — append-only, never edited or deleted.
      match /alerts/{alertId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      // Session stats.
      match /session/{doc} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null;
      }

      // Breadcrumb track points (F1/F2) — append-only.
      match /track/{point} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // ── Validation ──────────────────────────────────────────────────────
    // Every field check is conditional on the field being present, so that
    // partial merge-updates (snapshot-only, heartbeat-only, trip-only) all
    // pass. A field is validated only when it is actually being written.
    function isValidRiderUpdate(data) {
      return (!('eyeState'  in data) || data.eyeState in ['OPEN', 'CLOSED', 'UNKNOWN'])
          && (!('connected' in data) || data.connected is bool)
          && (!('riderName' in data) || (data.riderName is string && data.riderName.size() <= 80))
          && (!('perclos'   in data) || (data.perclos is number && data.perclos >= 0 && data.perclos <= 100))
          && (!('appState'  in data) || data.appState in ['FOREGROUND', 'BACKGROUND', 'ENDED']);
    }
  }
}
